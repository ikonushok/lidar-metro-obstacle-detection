    { "id": "envelope", "lane": "geometry", "col": 3, "type": "security", "label": "Tangent envelope", "tag": "ASSUMED", "width": 160 },
    { "id": "raw_core", "lane": "components", "col": 3, "type": "database", "label": "Raw CORE", "width": 150 },
    { "id": "components", "lane": "components", "col": 4, "type": "backend", "label": "CORE components", "width": 155 },
    { "id": "model", "lane": "decision", "col": 4, "type": "backend", "label": "candidate_baseline_v2", "width": 190 },
