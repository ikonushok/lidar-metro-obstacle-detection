  "cards": [
    { "dot": "cyan", "title": "Основной путь", "items": ["PointCloud2 декодируется в source frame", "AutoRails строит локальную ось", "CORE сохраняется до модели"] },
    { "dot": "emerald", "title": "Фильтр сигнала", "items": ["candidate_baseline_v2 поднимает reportable-компоненты", "Raw CORE остаётся диагностическим слоем"] },
    { "dot": "rose", "title": "Safety contract", "items": ["UNKNOWN не трактуется как CLEAR", "Отрицательный ответ модели не разрешает движение"] }
