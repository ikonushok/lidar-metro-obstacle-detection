{
  "format": "lidar-metro-runtime-policy-v1",
  "name": "baseline_v3",
  "version": "2026-09-27-submission",
  "purpose": "HACKATHON_INTRUSION_CANDIDATE_RUNTIME_POLICY_NOT_A_SAFETY_CLEAR_DECISION",
  "implementation": {
    "type": "compiled_cpp_policy",
    "core_files": [
      "src/cpp/curve_envelope_core.cpp",
      "src/cpp/curve_pipeline_stream_cli.cpp",
      "src/lidar_mosmetro3d_cpp/src/curve_envelope_node.cpp"
    ],
    "default_runtime_modes": [
      "direct_cpp",
      "ros2"
    ],
    "runtime_parameter": {
      "name": "noise_filter_mode",
      "value": "baseline_v3"
    }
  },
  "input_contract": {
    "primary_input": "sensor_msgs/msg/PointCloud2 or decoded XYZ triplets",
    "required_runtime_checks": [
      "finite XYZ values",
      "supported source_frame",
      "actual PointCloud2 field offsets/datatypes/count/point_step/row_step",
      "rail support found for selected frame"
    ],
    "unknown_policy": "UNKNOWN_OR_DEGRADED_IS_NOT_CLEAR"
  },
  "rail_axis": {
    "selection_method": "development_candidate",
    "search": {
      "forward_min_m": 2.0,
      "forward_max_m": 80.0,
      "station_length_m": 2.0,
      "cell_width_m": 0.04
    },
    "forward_extension": {
      "method": "tangent",
      "synthetic_extension": true,
      "detection_range_claim": false
    }
  },
  "train_envelope": {
    "coordinate_contract": "source-axis frame derived from observed rail pairs",
    "core_bounds_source_axis": {
      "left_m": -1.4,
      "right_m": 1.4,
      "bottom_m": 0.0,
      "top_m": 3.7
    },
    "margin_m": {
      "left": 0.5,
      "right": 0.5,
      "bottom": 0.5,
      "top": 0.5
    },
    "expanded_bounds_source_axis": {
      "left_m": -1.9,
      "right_m": 1.9,
      "bottom_m": -0.5,
      "top_m": 4.2
    },
    "calibration_status": "ENGINEERING_ASSUMPTION_NO_EXTERNAL_MOUNTING_CALIBRATION"
  },
  "component_extraction": {
    "zone": "CORE",
    "connectivity_radius_m": 0.25,
    "features": [
      "point_count",
      "extent_x_m",
      "extent_y_m",
      "extent_z_m",
      "volume_m3",
      "density_points_per_m3",
      "centroid_distance_m",
      "nearest_distance_m"
    ]
  },
  "decision_policy": {
    "order": [
      "boundary_warning",
      "strong_geometry_obstacle",
      "baseline_v3_assist_score",
      "unknown_or_ignored"
    ],
    "boundary_warning": {
      "min_points": 250,
      "rules": [
        {
          "name": "left_edge_vertical_boundary",
          "all": [
            "centroid_x < -1.30",
            "extent_x < 0.25",
            "extent_z > 1.50"
          ],
          "output": "OBSERVED_BOUNDARY_WARNING_NOT_OBSTACLE"
        },
        {
          "name": "upper_large_boundary",
          "all": [
            "centroid_z > 1.00",
            "extent_x > 1.00",
            "extent_y > 1.00",
            "extent_z > 0.30"
          ],
          "output": "OBSERVED_BOUNDARY_WARNING_NOT_OBSTACLE"
        }
      ]
    },
    "strong_geometry_obstacle": {
      "min_points": 1000,
      "requires": [
        "not boundary_warning"
      ],
      "output": "BASELINE_V3_CONFIRMED_INTRUSION_CANDIDATE"
    },
    "model_assist": {
      "score_name": "baseline_v3_assist_score",
      "threshold": 0.8064516129032258,
      "applies_when": [
        "not boundary_warning",
        "component.point_count < 1000"
      ],
      "frame_output": "BASELINE_V3_MODEL_ASSIST_WAITING_FOR_TEMPORAL_CONFIRMATION",
      "temporal_confirmation": {
        "direct_cpp": {
          "rule": "current model-assist alarm and previous frame model-assist alarm",
          "consecutive_alarm_frames_required": 2
        },
        "ros2": {
          "rule": "frame-level model-assist candidate is exposed; stream-level temporal confirmation is conservative and does not permit safety clear"
        }
      }
    },
    "unknown_or_ignored": {
      "if_raw_core_without_reportable_candidate": "BASELINE_V3_WEAK_OR_UNCONFIRMED_CORE_UNKNOWN_NOT_CLEAR",
      "if_no_supported_result": "UNKNOWN",
      "safety_decision_permitted": false
    }
  },
  "outputs": {
    "primary_json_fields": [
      "intrusion_candidate_present",
      "nearest_reportable_intrusion_distance_from_source_origin_m",
      "status",
      "reason",
      "system_status",
      "safety_decision_permitted",
      "baseline_v3_geometry_obstacle_count",
      "baseline_v3_boundary_warning_count",
      "baseline_v3_model_assist_count"
    ],
    "distance_contract": "distance is from source coordinate origin, not from train nose"
  },
  "known_limits": [
    "not production-certified",
    "no CLEAR decision",
    "no external mounting calibration",
    "no TF/IMU/odometry/map dependency in MVP",
    "80m is geometry extension parameter, not measured detection range",
    "baseline_v3_assist_score is internal to the baseline_v3 runtime policy"
  ],
